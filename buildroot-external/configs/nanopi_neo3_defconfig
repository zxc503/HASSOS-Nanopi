BR2_aarch64=y                    # 使用64位ARM架构
BR2_cortex_a53=y                # 使用Cortex-A53处理器
BR2_ARM_FPU_VFPV4=y             # 启用VFPv4浮点单元
BR2_DL_DIR="/cache/dl"          # 设置下载目录为/cache/dl
BR2_CCACHE=y                    # 启用编译缓存
BR2_CCACHE_DIR="/cache/cc"      # 设置编译缓存目录为/cache/cc
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_HASSOS_PATH)/patches" #$(BR2_EXTERNAL_HASSOS_PATH)/board/radxa/patches"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ENABLE_LTO=y                # 启用链接时优化
BR2_GCC_VERSION_11_X=y          # 使用GCC 11.x版本
BR2_INIT_SYSTEMD=y              # 使用systemd作为init系统
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HASSOS_PATH)/rootfs-overlay"    # 设置根文件系统覆盖目录
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HASSOS_PATH)/scripts/post-build.sh"    # 设置构建后脚本
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HASSOS_PATH)/scripts/post-image.sh"    # 设置镜像生成后脚本
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_HASSOS_PATH)/board/nanopi/nanopi_neo3   $(BR2_EXTERNAL_HASSOS_PATH)/board/nanopi/nanopi_neo3/hassos-hook.sh"    # 设置脚本参数
BR2_SSP_REGULAR=y               # 启用常规栈保护
BR2_TARGET_GENERIC_HOSTNAME="homeassistant"    # 设置主机名为homeassistant
BR2_TARGET_GENERIC_ISSUE="Welcome to Home Assistant"    # 设置登录提示信息
BR2_TARGET_ROOTFS_EROFS=y       # 使用EROFS根文件系统
BR2_TARGET_ROOTFS_EROFS_LZ4HC_LEVEL=12
BR2_TARGET_ROOTFS_EROFS_DEDUPE=y    # 启用EROFS重复数据删除
BR2_TARGET_ROOTFS_EROFS_FRAGMENTS=y    # 启用EROFS分片
BR2_TARGET_ROOTFS_EROFS_ZTAILPACKING=y    # 启用EROFS尾部打包
BR2_TARGET_ROOTFS_EROFS_PCLUSTERSIZE=262144
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TOOLCHAIN_BUILDROOT_CXX=y    # 启用C++支持
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y    # 使用GLIBC作为C库

# Firmware
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_LATEST_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="rk3328"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y

# Bootloader
BR2_TARGET_UBOOT=y              # 启用U-Boot
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y    # 使用Kconfig构建系统
BR2_TARGET_UBOOT_CUSTOM_VERSION=y    # 使用自定义U-Boot版本
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.01"    # U-Boot版本为2024.01
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="nanopi-r2s-rk3328"    # 设置开发板配置
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HASSOS_PATH)/bootloader/uboot.config" #$(BR2_EXTERNAL_HASSOS_PATH)/board/nanopi/uboot.config"
BR2_TARGET_UBOOT_NEEDS_DTC=y    # 需要设备树编译器
BR2_TARGET_UBOOT_NEEDS_PYTHON3=y    # 需要Python3
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y    # 需要pyelftools
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y    # 需要pylibfdt
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31_ELF=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_IMAGES="bl31/*.elf"
BR2_TARGET_UBOOT_SPL=y                  # 需要SPL
BR2_TARGET_UBOOT_SPL_NAME="u-boot-rockchip.bin"

# Kernel
BR2_LINUX_KERNEL=y              # 启用Linux内核
BR2_LINUX_KERNEL_CUSTOM_VERSION=y    # 使用自定义内核版本
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.66"    # 内核版本为6.6.66
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y    # 使用自定义内核配置
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_HASSOS_PATH)/kernel/v6.6.y/kernel-arm64-rockchip.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HASSOS_PATH)/kernel/v6.6.y/hassos.config $(BR2_EXTERNAL_HASSOS_PATH)/kernel/v6.6.y/docker.config $(BR2_EXTERNAL_HASSOS_PATH)/kernel/v6.6.y/device-support.config"
# BR2_LINUX_KERNEL_LZ4=y          # 使用LZ4压缩内核
# BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y    # 启用设备树支持
