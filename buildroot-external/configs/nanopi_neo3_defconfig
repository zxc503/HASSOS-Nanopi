BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y    # 支持设备树覆盖
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y    # 需要主机OpenSSL
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y    # 需要主机libelf

